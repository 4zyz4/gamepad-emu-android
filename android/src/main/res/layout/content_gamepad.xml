<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF2B2B2B">

    <com.zyz4.gamepademu.view.GamepadLayout
        android:id="@+id/gamepadLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Row: Triggers / Bumpers -->
        <Button
            android:id="@+id/btnLT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_rounded_rect"
            android:gravity="center"
            android:text="LT"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_rounded_rect"
            android:gravity="center"
            android:text="LB"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_rounded_rect"
            android:gravity="center"
            android:text="RB"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_rounded_rect"
            android:gravity="center"
            android:text="RT"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- D-Pad -->
        <ImageButton
            android:id="@+id/btnDpadUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_circle"
            android:contentDescription="Up"
            android:src="@drawable/ic_arrow_up" />

        <ImageButton
            android:id="@+id/btnDpadDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_circle"
            android:contentDescription="Down"
            android:src="@drawable/ic_arrow_down" />

        <ImageButton
            android:id="@+id/btnDpadLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_circle"
            android:contentDescription="Left"
            android:src="@drawable/ic_arrow_left" />

        <ImageButton
            android:id="@+id/btnDpadRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_circle"
            android:contentDescription="Right"
            android:src="@drawable/ic_arrow_right" />

        <!-- ABXY -->
        <Button
            android:id="@+id/btnA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_circle"
            android:gravity="center"
            android:text="A"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_circle"
            android:gravity="center"
            android:text="B"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnX"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_circle"
            android:gravity="center"
            android:text="X"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnY"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_circle"
            android:gravity="center"
            android:text="Y"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Joysticks -->
        <com.zyz4.gamepademu.view.JoystickView
            android:id="@+id/leftJoystick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.zyz4.gamepademu.view.JoystickView
            android:id="@+id/rightJoystick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Center Touchpad (DS4) -->
        <FrameLayout
            android:id="@+id/centerArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/center_rect"
            android:visibility="gone">

            <TextView
                android:id="@+id/centerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#FF666666"
                android:textSize="11sp" />
        </FrameLayout>

        <!-- Bottom buttons -->
        <Button
            android:id="@+id/btnSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_circle"
            android:gravity="center"
            android:text="SEL"
            android:textColor="#FFCCCCCC"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_circle"
            android:contentDescription="Home"
            android:src="@drawable/ic_home" />

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_circle"
            android:gravity="center"
            android:text=""
            android:textColor="#FFCCCCCC"
            android:textSize="10sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

    </com.zyz4.gamepademu.view.GamepadLayout>

    <!-- Fixed overlay: Settings button (top-center) -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_small_btn"
        android:contentDescription="Settings"
        android:src="@drawable/ic_settings"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:layout_gravity="top|center_horizontal" />

    <!-- Fixed overlay: Status text (top-center) -->

    <!-- Edit mode toolbar (visible in edit mode) -->
    <LinearLayout
        android:id="@+id/editToolbar"
        android:layout_width="200dp"
        android:layout_height="36dp"
        android:background="#CC1A1A1A"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone"
        android:layout_gravity="center_horizontal|top">

        <Button
            android:id="@+id/btnEditSave"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_rounded_rect"
            android:text="保存"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnEditDiscard"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/button_rounded_rect"
            android:text="放弃"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:stateListAnimator="@null" />
    </LinearLayout>

</FrameLayout>
